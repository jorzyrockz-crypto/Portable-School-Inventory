rules_version = '2';

// CustodianPro · Supply Requests
// Publish in Firebase console → Firestore Database → Rules (see README).
//
//   schools/{schoolId}                        a school; custodians[] may manage it
//   schools/{schoolId}/requests/{id}          supply requests from teachers
//   schools/{schoolId}/purchaseRequests/{id}  Purchase Requests (Appendix 60)
//   schools/{schoolId}/inspections/{id}       deliveries inspected on a PR (IAR, Appendix 62)
//   schools/{schoolId}/inventory/{code}       My Items (school inventory), custodian only
//   schools/{schoolId}/catalog/{code}         custom catalog items, custodian only
//   schools/{schoolId}/settings/info          school & custodian info, custodian only
//   schools/{schoolId}/members/{uid}          teachers who joined (each writes their own)
//   schools/{schoolId}/releases/{id}          RIS / ICS releases to teachers (teacher reads own)
//   schools/{schoolId}/teacherReports/{id}    received / problem / return / count / life, from teachers (own only)
//   schools/{schoolId}/stock/{code}           supplies left (name, unit, qty), for teachers who were approved
//   schools/{schoolId}/stockHolds/{requestId} "I took this" from a teacher, until the custodian confirms
//   schools/{schoolId}/invites/{code}         the current invite link (after "New invite link")
//   schools/{schoolId}/heads/{uid}            the School Head (joins with Google, the custodian confirms)
//   schools/{schoolId}/headInvites/{code}     the School Head's invite link
//   schools/{schoolId}/turnovers/{uid-code}   a new property custodian taking over (custodian turnover)
//   schools/{schoolId}/turnoverInvites/{code} the Turnover link (made by the custodian or the School Head)
//   schools/{schoolId}/approvals/{id}         RIS, write-offs and count reports for the School Head to approve
//   schools/{schoolId}/dashboard/summary      the School Head's summary of the school's property
//   schools/{schoolId}/books/{id}             Books & Library: one title, its copies per place (staff, librarian)
//   schools/{schoolId}/bookMeta/places        the places where books are kept, with their keepers
//   schools/{schoolId}/bookIndex/{n}          the library catalogue every teacher and the School Head read (no learner names)
//   schools/{schoolId}/bookMoves/{id}         books issued to an adviser (Book Issuance List), taken back, moved
//   schools/{schoolId}/loans/{id}             borrowing: the borrower, the keeper of the copies, the librarian
//   schools/{schoolId}/classBooks/{sy_uid}    an adviser's class: textbooks with learners (adviser + custodian only)
//   schools/{schoolId}/leaves/{id}            an application for leave, CS Form 6 (pilot schools only)
//   schools/{schoolId}/leaveCards/{uid|id}    a person's leave card: credits earned and used (pilot schools only)
//   schoolIds/{schoolNo}                      DepEd School ID (6 digits) → school, so teachers can type it
//
// Members: a teacher who joins waits for the custodian's approval (status 'pending'), then is
// 'active'; the custodian can also edit their name or remove them ('removed'). Cards written
// before approvals existed have no status and count as active. Only active members send
// requests or reports and see the stock.
// Teachers join from the invite link (anonymously, or with Google to keep their requests
// across phones): they can send requests and see or cancel only their own. The property
// custodian signs in with Google or email + password and sees, reviews and approves
// every request of their school.
//
// School Head: joins from their own invite link with their own Google account and waits for
// the custodian to confirm them. The confirmed head's uid is kept on the school (headUid; never
// one of the custodians, so nobody approves their own PR). The head reads the Purchase
// Requests and may only approve or return the ones waiting for approval. Until a head is
// confirmed, the custodian records the date the head signed the printed PR ("signed on paper").
//
// Custodian turnover: the new custodian opens the Turnover link and signs in with their own Google
// account (a turnovers card, 'pending'). The outgoing custodian, or the confirmed School Head,
// confirms it in one batch: the card becomes 'done' and the school gets custodians [new uid],
// ownerUid = new uid and turnoverId = the card. The outgoing custodians go to viewOnly (with an
// end time, untilMs) and viewerUids: they may still READ the school's records until then, never
// write. The School Head is never the custodian.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // A real account (not an anonymous teacher) may set up a school.
    function withAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider in ['password', 'google.com'];
    }
    function isCustodian(schoolId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/schools/$(schoolId)).data.custodians;
    }
    // A custodian who turned the school over: read only, until their view-only access ends.
    function isViewer(schoolId) {
      return signedIn() && get(/databases/$(database)/documents/schools/$(schoolId)).data
        .get('viewOnly', {}).get(request.auth.uid, {}).get('untilMs', 0) > request.time.toMillis();
    }
    // An assistant custodian (school.assistants, added by the custodian): releases, encodes and
    // handles requests like the custodian, but can't delete, hand over, manage the School Head,
    // teachers or invite links, or change the school.
    function isAssistant(schoolId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/schools/$(schoolId)).data.get('assistants', [])
        && notErasing(schoolId);
    }
    function isStaff(schoolId) { return isCustodian(schoolId) || isAssistant(schoolId); }
    function canView(schoolId) { return isStaff(schoolId) || isViewer(schoolId); }
    // Inventory and catalog: the assistant can't remove items ({ deleted: true }).
    function staffInvWrite(schoolId) {
      return isCustodian(schoolId) || (isAssistant(schoolId) && request.resource.data.get('deleted', false) != true);
    }
    function turnPath(schoolId, id) {
      return /databases/$(database)/documents/schools/$(schoolId)/turnovers/$(id);
    }
    // The school after a confirmed turnover: one custodian (the new one), whose card was pending
    // before this batch and is 'done' after it. The outgoing custodians may only become viewers.
    function turnoverOk(schoolId) {
      let after = request.resource.data;
      return after.turnoverId is string
        && after.custodians == [after.ownerUid]
        && after.ownerUid != after.get('headUid', '')
        && get(turnPath(schoolId, after.turnoverId)).data.status == 'pending'
        && getAfter(turnPath(schoolId, after.turnoverId)).data.status == 'done'
        && getAfter(turnPath(schoolId, after.turnoverId)).data.uid == after.ownerUid
        && after.get('viewerUids', []).hasOnly(resource.data.custodians.concat(resource.data.get('viewerUids', [])))
        && after.get('viewOnly', {}).keys().hasOnly(resource.data.custodians.concat(resource.data.get('viewerUids', [])));
    }
    function shortText(v, max) { return v is string && v.size() <= max; }
    // Leave (CS Form 6) and leave cards: a pilot, only at these schools
    function leavePilot(schoolId) { return schoolId in ['97JbEODfGJhWcejYDWhO']; }
    // School Planning (the school calendar; programs, projects and activities next): a pilot too
    function planPilot(schoolId) { return schoolId in ['97JbEODfGJhWcejYDWhO']; }
    // A card's photo: the person's Google profile photo (lhN.googleusercontent.com), or empty.
    function googlePhotoOk() {
      return request.resource.data.get('photo', '') == ''
        || (request.resource.data.photo is string && request.resource.data.photo.size() <= 300
            && request.resource.data.photo.matches('^https://lh[0-9][.]googleusercontent[.]com/[^ ]+$'));
    }
    function schoolDoc(schoolId) { return get(/databases/$(database)/documents/schools/$(schoolId)).data; }
    // The confirmed School Head of the school (set by the custodian when they confirm the head).
    function isHead(schoolId) {
      return signedIn() && schoolDoc(schoolId).get('headUid', '') == request.auth.uid
        && !(request.auth.uid in schoolDoc(schoolId).custodians)
        && !(request.auth.uid in schoolDoc(schoolId).get('assistants', []));
    }
    function headJoined(schoolId) { return schoolDoc(schoolId).get('headUid', '') != ''; }
    // The Librarian: an active teacher the custodian listed in school.librarians (their member card
    // also says librarian: true). Books, places and lending only.
    function isLibrarian(schoolId) {
      return request.auth.uid in schoolDoc(schoolId).get('librarians', []) && isMember(schoolId);
    }
    function bookStaff(schoolId) { return isStaff(schoolId) || isLibrarian(schoolId); }
    function apprStatus(d) { return d.get('approval', {}).get('status', ''); }
    function memberPath(schoolId) {
      return /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid);
    }
    function isMember(schoolId) {
      return signedIn() && exists(memberPath(schoolId))
        && get(memberPath(schoolId)).data.get('status', 'active') == 'active'
        && notErasing(schoolId);
    }
    // Reset app marks the school { erasing } before deleting it: no new cards or teacher writes.
    function notErasing(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)).data.get('erasing', 0) == 0;
    }
    // After "New invite link", joining needs the current link's code.
    function inviteOk(schoolId, data) {
      return !get(/databases/$(database)/documents/schools/$(schoolId)).data.get('inviteOnly', false)
        || (data.get('invite', '') is string && data.get('invite', '').size() > 0
            && exists(/databases/$(database)/documents/schools/$(schoolId)/invites/$(data.invite))
            && get(/databases/$(database)/documents/schools/$(schoolId)/invites/$(data.invite)).data.active == true);
    }

    // A teacher's own list of schools they joined with this Google account, so "Continue with
    // Google" on the Teacher sign-in can bring them back without the invite link. Only they can
    // read or write it. It is only a pointer: the app then reads their member card, which the
    // member rules guard as before.
    match /teacherSchools/{uid} {
      allow get, delete: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly(['schools', 'updatedMs'])
        && request.resource.data.schools is list && request.resource.data.schools.size() <= 10
        && request.resource.data.updatedMs is int;
    }

    // DepEd School ID → school: a teacher may type "114656" instead of the school code, and a
    // custodian setting up a school is told when its ID is already set up (hint: the masked email
    // and sign-in method of the account that did it, e.g. "r***a@deped.gov.ph · Google"). Only
    // an exact ID can be looked up (no listing). One school per ID: the first custodian who
    // lists it keeps it, and only a custodian of that school can change or remove it. Joining
    // still waits for the custodian's Approve, and an invite-only school still needs its link.
    match /schoolIds/{schoolNo} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && schoolNo.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['schoolId', 'name', 'updatedMs', 'hint'])
        && shortText(request.resource.data.get('hint', ''), 80)
        && request.resource.data.schoolId is string
        && isCustodian(request.resource.data.schoolId)
        && shortText(request.resource.data.name, 120);
      allow update: if request.resource.data.keys().hasOnly(['schoolId', 'name', 'updatedMs', 'hint'])
        && shortText(request.resource.data.name, 120)
        && shortText(request.resource.data.get('hint', ''), 80)
        && ((isCustodian(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId)
            // its school was erased (Reset app): free for the next school that lists it
            || (!exists(/databases/$(database)/documents/schools/$(resource.data.schoolId))
                && request.resource.data.schoolId is string
                && isCustodian(request.resource.data.schoolId)));
      allow delete: if isCustodian(resource.data.schoolId);
    }

    match /schools/{schoolId} {
      // Teachers read the school name after opening the invite link (the ID is the secret).
      allow get: if signedIn();
      // A custodian finds their own school on a new device (query: custodians array-contains uid),
      // and a custodian who turned it over finds it while view-only (viewerUids array-contains uid).
      allow list: if signedIn() && (request.auth.uid in resource.data.custodians
        || request.auth.uid in resource.data.get('viewerUids', [])
        || request.auth.uid in resource.data.get('assistants', [])
        // and the confirmed School Head finds their school with Continue with Google (headUid == uid)
        || (request.auth.token.firebase.sign_in_provider == 'google.com' && resource.data.get('headUid', '') == request.auth.uid));
      allow create: if withAccount()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.custodians == [request.auth.uid]
        && shortText(request.resource.data.name, 120);
      // headUid: the confirmed School Head, never one of the custodians (no self-approval).
      // ownerUid changes only with a confirmed turnover, by the outgoing custodian or the School Head
      // (who may change nothing else on the school).
      allow update: if (isCustodian(schoolId)
          && (request.resource.data.ownerUid == resource.data.ownerUid || turnoverOk(schoolId))
          && !(request.resource.data.get('headUid', '') in request.resource.data.custodians)
          && !(request.resource.data.get('headUid', '') in request.resource.data.get('assistants', []))
          && !(request.resource.data.ownerUid in request.resource.data.get('assistants', [])))
        || (isHead(schoolId) && turnoverOk(schoolId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['custodians', 'ownerUid', 'turnoverId', 'turnoverMs',
                                                                               'custodianName', 'custodianDesig', 'viewOnly', 'viewerUids', 'assistants'])
          // an assistant who takes over leaves the assistants (the head can only remove)
          && request.resource.data.get('assistants', []).hasOnly(resource.data.get('assistants', []))
          && !(request.resource.data.ownerUid in request.resource.data.get('assistants', [])));
      // More → Reset app → "and the school in the cloud": the custodian erases every document
      // of the school (its sub-collections first, this document last). Nobody else can delete.
      allow delete: if isCustodian(schoolId);

      match /requests/{requestId} {
        // kind 'took': the teacher already took it from the supply room (custodian confirms → RIS)
        allow create: if (isStaff(schoolId) || isMember(schoolId))
          && request.resource.data.keys().hasOnly(['uid', 'name', 'position', 'office', 'purpose', 'neededBy',
                                                   'lines', 'status', 'createdAt', 'clientAt', 'via', 'kind'])
          && request.resource.data.get('kind', 'request') in ['request', 'took']
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && shortText(request.resource.data.position, 80)
          && shortText(request.resource.data.office, 80)
          && shortText(request.resource.data.purpose, 300)
          && request.resource.data.lines is list
          && request.resource.data.lines.size() > 0 && request.resource.data.lines.size() <= 50;

        // Teachers: only their own requests (the app queries where uid == their uid).
        allow get, list: if signedIn()
          && (resource.data.uid == request.auth.uid || canView(schoolId));

        // Custodian: review, approve, decline, put on a PR. Teacher: cancel while pending.
        // Same teacher, two accounts: the custodian moves the request to the account they keep
        // (stamped mergedFrom = the old account).
        allow update: if (isStaff(schoolId) && request.resource.data.uid == resource.data.uid)
          || (isCustodian(schoolId) && request.resource.data.get('mergedFrom', '') == resource.data.uid)
          || (signedIn() && resource.data.uid == request.auth.uid
              && resource.data.status == 'pending'
              && request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // Purchase Requests always need the School Head's approval:
      //   approval { status: 'pending' | 'approved' | 'returned', via: 'app' | 'paper', byUid, byName,
      //              byDesig, atMs, note, paperDate, submittedMs }
      // A new PR waits ('pending'). The confirmed head approves or returns it (with a note) in the
      // app. Before a head is confirmed, the custodian records the paper signature instead. The
      // custodian may send a PR back for approval at any time, but may not change what is on an
      // approved PR without sending it back. PRs saved before approvals existed have no approval.
      match /purchaseRequests/{prId} {
        function prContent() {
          return ['prNo', 'date', 'entity', 'fund', 'office', 'rcc', 'purpose', 'lines', 'total',
                  'requestIds', 'requesters', 'requestedBy', 'approvedBy'];
        }
        function custodianApprovalOk() {
          return request.resource.data.get('approval', null) == resource.data.get('approval', null)
            ? !(apprStatus(resource.data) == 'approved'
                && request.resource.data.diff(resource.data).affectedKeys().hasAny(prContent()))
            : apprStatus(request.resource.data) == 'pending'
              || (apprStatus(request.resource.data) == 'approved'
                  && request.resource.data.approval.get('via', '') == 'paper'
                  && !headJoined(schoolId));
        }
        function headDecisionOk() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approval', 'updatedAt'])
            && apprStatus(resource.data) == 'pending'
            && request.resource.data.approval.get('status', '') in ['approved', 'returned']
            && request.resource.data.approval.get('via', '') == 'app'
            && request.resource.data.approval.get('byUid', '') == request.auth.uid
            && shortText(request.resource.data.approval.get('note', ''), 300);
        }
        allow read: if canView(schoolId) || isHead(schoolId);
        allow create: if isStaff(schoolId) && apprStatus(request.resource.data) == 'pending';
        allow update: if (isStaff(schoolId) && custodianApprovalOk())
          || (isHead(schoolId) && headDecisionOk());
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // Inspection of a delivery (IAR): the custodian makes it. When it is sent to a teacher's
      // phone (inspectorUid), that teacher reads it and signs it once: they may only fill in the
      // quantities and notes and mark it 'inspected'. The custodian accepts it afterwards.
      match /inspections/{inspId} {
        allow create: if isStaff(schoolId);
        allow update: if isStaff(schoolId)
          || (isMember(schoolId)
              && resource.data.inspectorUid == request.auth.uid
              && resource.data.status == 'assigned'
              && request.resource.data.status == 'inspected'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['lines', 'status', 'inspectedMs', 'dateInspected', 'inspectedVia', 'updatedAt'])
              && request.resource.data.lines is list
              && request.resource.data.lines.size() == resource.data.lines.size());
        allow get, list: if signedIn()
          && (resource.data.inspectorUid == request.auth.uid || canView(schoolId));
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // School inventory (My Items), custom catalog items and school info: the custodian's
      // devices only. Teachers never read the inventory. Removed items are marked
      // { deleted: true } instead of being deleted.
      // The School Head reads the inventory too (Items tab, view only; changes are suggestions).
      match /inventory/{code} {
        allow read: if canView(schoolId) || isHead(schoolId);
        allow create, update: if staffInvWrite(schoolId);
        allow delete: if isCustodian(schoolId);   // Reset app only
      }
      match /catalog/{code} {
        allow read: if canView(schoolId) || isHead(schoolId);
        allow create, update: if staffInvWrite(schoolId);
        allow delete: if isCustodian(schoolId);   // Reset app only
      }
      match /settings/{docId} {
        allow read: if canView(schoolId) || isHead(schoolId);
        allow create, update: if isStaff(schoolId);
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // Teachers who joined: each teacher's phone writes its own card (name, position, office),
      // starting as 'pending'. The custodian reads all of them, approves, edits or removes.
      match /members/{uid} {
        // photo: the teacher's Google profile photo (shown on the Teachers page), or empty.
        function photoOk() {
          return request.resource.data.get('photo', '') == ''
            || (request.resource.data.photo is string && request.resource.data.photo.size() <= 300
                && request.resource.data.photo.matches('^https://lh[0-9][.]googleusercontent[.]com/[^ ]+$'));
        }
        function cardOk() {
          return request.resource.data.uid == uid
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
            && shortText(request.resource.data.position, 80)
            && shortText(request.resource.data.office, 80)
            && shortText(request.resource.data.get('email', ''), 120);
        }
        allow get: if signedIn() && (request.auth.uid == uid || canView(schoolId));
        allow list: if canView(schoolId);
        allow create: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/schools/$(schoolId))
          && notErasing(schoolId)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'position', 'office', 'email', 'joinedMs', 'updatedAt', 'status', 'invite'])
          && request.resource.data.status == 'pending'
          && inviteOk(schoolId, request.resource.data)
          && cardOk();
        // The teacher: their own details only (never the status).
        allow update: if (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'position', 'office', 'email', 'joinedMs', 'updatedAt', 'photo'])
            && cardOk() && photoOk())
          // The custodian: approve, remove, or correct the details.
          || (isCustodian(schoolId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'position', 'office', 'status',
                                                                                 'approvedMs', 'removedMs', 'editedMs', 'by', 'updatedAt',
                                                                                 'librarian', 'librarianMs', 'mergedInto', 'mergedIntoName', 'mergedMs'])
            && request.resource.data.get('status', 'active') in ['pending', 'active', 'removed']
            && cardOk());
        // Reset app, and "Delete entirely" for a teacher with no records at all.
        allow delete: if isCustodian(schoolId);
      }

      // The current invite link's code (the school document only says inviteOnly: true).
      match /invites/{code} {
        allow get: if signedIn();
        allow create, update: if isCustodian(schoolId);
        allow list, delete: if isCustodian(schoolId);   // Reset app finds and erases them
      }

      // The School Head: joins from the head invite link with their own Google account (never
      // a custodian of the school), starting as 'pending'. The custodian confirms ('active'),
      // which also sets headUid on the school, or removes them ('removed').
      match /heads/{uid} {
        function headCardOk() {
          return request.resource.data.uid == uid
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
            && shortText(request.resource.data.designation, 80)
            && shortText(request.resource.data.get('email', ''), 120);
        }
        allow get: if signedIn() && (request.auth.uid == uid || canView(schoolId));
        allow list: if canView(schoolId);
        allow create: if signedIn() && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && exists(/databases/$(database)/documents/schools/$(schoolId))
          && notErasing(schoolId)
          && !isStaff(schoolId)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'designation', 'email', 'joinedMs', 'status', 'invite', 'updatedAt'])
          && request.resource.data.status == 'pending'
          && request.resource.data.invite is string && request.resource.data.invite.size() > 0
          && exists(/databases/$(database)/documents/schools/$(schoolId)/headInvites/$(request.resource.data.invite))
          && get(/databases/$(database)/documents/schools/$(schoolId)/headInvites/$(request.resource.data.invite)).data.active == true
          && headCardOk();
        allow update: if (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'designation', 'email', 'updatedAt', 'photo'])
            && headCardOk() && googlePhotoOk())
          || (isCustodian(schoolId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'designation', 'status',
                                                                                 'approvedMs', 'removedMs', 'by', 'updatedAt'])
            && request.resource.data.status in ['pending', 'active', 'removed']
            && headCardOk());
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // The School Head's invite link code.
      match /headInvites/{code} {
        allow get: if signedIn();
        allow create, update, list, delete: if isCustodian(schoolId);
      }

      // Custodian turnover. The incoming custodian writes their own card from a live Turnover link,
      // with their own Google account (never a custodian or the School Head of this school). The
      // outgoing custodian or the School Head confirms it ('done', together with the school in the
      // same batch: see turnoverOk) or declines it.
      match /turnovers/{turnId} {
        function turnCardOk() {
          return request.resource.data.name is string
            && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
            && shortText(request.resource.data.designation, 80)
            && shortText(request.resource.data.get('email', ''), 120);
        }
        // (the card's ID starts with its owner's uid, so they can look for it before it exists)
        allow get: if signedIn() && (turnId.split('-')[0] == request.auth.uid || canView(schoolId) || isHead(schoolId));
        allow list: if canView(schoolId) || isHead(schoolId);
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && turnId == request.auth.uid + '-' + request.resource.data.invite
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && exists(/databases/$(database)/documents/schools/$(schoolId))
          && notErasing(schoolId)
          && !isCustodian(schoolId)
          && schoolDoc(schoolId).get('headUid', '') != request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'designation', 'email', 'joinedMs', 'status', 'invite', 'createdAt'])
          && request.resource.data.status == 'pending'
          && request.resource.data.invite is string && request.resource.data.invite.size() > 0
          && exists(/databases/$(database)/documents/schools/$(schoolId)/turnoverInvites/$(request.resource.data.invite))
          && get(/databases/$(database)/documents/schools/$(schoolId)/turnoverInvites/$(request.resource.data.invite)).data.active == true
          && turnCardOk();
        allow update: if (isCustodian(schoolId) || isHead(schoolId))
          && resource.data.status == 'pending'
          && request.resource.data.uid == resource.data.uid
          && ((request.resource.data.status == 'declined'
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'by', 'doneMs', 'updatedAt']))
            || (request.resource.data.status == 'done'
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'fromUids', 'fromName', 'fromDesig',
                                                                                    'assumedOn', 'confirmedBy', 'doneMs', 'updatedAt'])
               && request.resource.data.confirmedBy.uid == request.auth.uid
               && getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.custodians == [resource.data.uid]
               && getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.get('turnoverId', '') == turnId));
        allow delete: if isCustodian(schoolId);   // Reset app only
      }
      // Assistant custodians: join from the assistant link with their own Google account (never
      // a custodian or the School Head), starting as 'pending'. The custodian confirms ('active',
      // and adds them to school.assistants in the same batch) or removes them ('removed'). A
      // removed assistant may ask again with a current link.
      match /staff/{uid} {
        function staffCardOk() {
          return request.resource.data.uid == uid
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
            && shortText(request.resource.data.designation, 80)
            && shortText(request.resource.data.get('email', ''), 120);
        }
        function staffInviteOk() {
          return request.resource.data.invite is string && request.resource.data.invite.size() > 0
            && exists(/databases/$(database)/documents/schools/$(schoolId)/staffInvites/$(request.resource.data.invite))
            && get(/databases/$(database)/documents/schools/$(schoolId)/staffInvites/$(request.resource.data.invite)).data.active == true;
        }
        allow get: if signedIn() && (request.auth.uid == uid || canView(schoolId));
        allow list: if canView(schoolId);
        allow create: if signedIn() && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && exists(/databases/$(database)/documents/schools/$(schoolId))
          && notErasing(schoolId)
          && !isStaff(schoolId)
          && schoolDoc(schoolId).get('headUid', '') != uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'designation', 'email', 'joinedMs', 'status', 'invite', 'createdAt'])
          && request.resource.data.status == 'pending'
          && staffInviteOk() && staffCardOk();
        allow update: if (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'designation', 'email', 'updatedAt', 'photo'])
            && staffCardOk() && googlePhotoOk())
          // asks again after being removed (a current link)
          || (signedIn() && request.auth.uid == uid && resource.data.status == 'removed'
            && request.resource.data.status == 'pending' && !isStaff(schoolId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'designation', 'email', 'status', 'invite', 'joinedMs', 'updatedAt'])
            && staffInviteOk() && staffCardOk())
          || (isCustodian(schoolId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedMs', 'removedMs', 'by', 'updatedAt'])
            && request.resource.data.status in ['pending', 'active', 'removed']);
        allow delete: if isCustodian(schoolId);   // Reset app only
      }
      match /staffInvites/{code} {
        allow get: if signedIn();
        allow create, update, list, delete: if isCustodian(schoolId);
      }

      // What the School Head approves besides the PR: a supply request's RIS (kind 'ris', when the
      // custodian turned it on), a write-off ('writeoff': a lost unit's relief or a written-off unit)
      // and the physical count report ('count'). The custodian's devices send them ('pending') once a
      // head is confirmed, and may send one again or cancel it, or mark an approved write-off as
      // done (appliedMs), never decide. Only the confirmed head approves or returns ('decision').
      match /approvals/{apId} {
        function apBodyOk() {
          let d = request.resource.data;
          return d.kind in ['ris', 'writeoff', 'count', 'books', 'leave']
            && d.refId is string && d.refId.size() > 0 && d.refId.size() <= 120
            && shortText(d.get('title', ''), 160) && shortText(d.get('summary', ''), 600)
            && d.get('lines', []) is list && d.get('lines', []).size() <= 200;
        }
        allow read: if canView(schoolId) || isHead(schoolId);
        allow create: if isStaff(schoolId) && headJoined(schoolId)
          && request.resource.data.status == 'pending'
          && !('decision' in request.resource.data)
          && request.resource.data.byUid == request.auth.uid
          && apBodyOk();
        allow update: if (isStaff(schoolId)
            && request.resource.data.get('decision', null) == resource.data.get('decision', null)
            && request.resource.data.kind == resource.data.kind
            && request.resource.data.refId == resource.data.refId
            && (resource.data.status == 'approved'
                  ? request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appliedMs', 'updatedAt'])
                  : request.resource.data.status in ['pending', 'cancelled'] && apBodyOk()))
          || (isHead(schoolId) && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decision', 'updatedAt'])
            && request.resource.data.status in ['approved', 'returned']
            && request.resource.data.decision.byUid == request.auth.uid
            && shortText(request.resource.data.decision.get('byName', ''), 80)
            && shortText(request.resource.data.decision.get('note', ''), 300));
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // The School Head's suggested changes to the inventory (Items tab): the head sends them, the
      // custodian or an assistant accepts (all or some items) or declines. The inventory itself only
      // changes on the custodian's devices, when they accept. The head may take one back.
      match /suggestions/{id} {
        function sugBodyOk() {
          return request.resource.data.ops is list
            && request.resource.data.ops.size() > 0 && request.resource.data.ops.size() <= 150
            && request.resource.data.get('lines', []) is list && request.resource.data.get('lines', []).size() <= 150
            && shortText(request.resource.data.get('title', ''), 160)
            && shortText(request.resource.data.get('byName', ''), 80);
        }
        allow read: if canView(schoolId) || isHead(schoolId);
        allow create: if isHead(schoolId)
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && !('decision' in request.resource.data)
          && sugBodyOk();
        allow update: if (isHead(schoolId) && resource.data.byUid == request.auth.uid && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'cancelled')
          || (isStaff(schoolId) && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decision', 'updatedAt'])
            && request.resource.data.status in ['accepted', 'declined']
            && request.resource.data.decision.byUid == request.auth.uid
            && shortText(request.resource.data.decision.get('note', ''), 300));
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // The School Head's summary (stock levels, who holds what, requests, condition), kept current
      // by the custodian's devices. The head also reads the inventory (Items tab).
      match /dashboard/{docId} {
        allow read: if canView(schoolId) || isHead(schoolId);
        allow create, update: if isStaff(schoolId) && docId == 'summary';
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // School history that can't be changed: each custodian device appends its Change History
      // entries (several per document), stamped with the account and the server time. The School
      // Head adds their own decisions. Nobody can edit or delete an entry, not even the custodian;
      // Reset app leaves them (the app owner still sees them in the Firebase console).
      match /auditLog/{id} {
        allow read: if canView(schoolId) || isHead(schoolId);
        allow create: if (isStaff(schoolId) || isHead(schoolId))
          && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'device', 'entries', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (request.resource.data.role == 'head') == isHead(schoolId)
          && (request.resource.data.role == 'assistant') == isAssistant(schoolId)
          && request.resource.data.role in ['custodian', 'head', 'assistant']
          && shortText(request.resource.data.name, 80)
          && shortText(request.resource.data.device, 40)
          && request.resource.data.entries is list
          && request.resource.data.entries.size() > 0
          && request.resource.data.entries.size() <= 100;
        allow update, delete: if false;
      }

      // ---- Books & Library -------------------------------------------------------------------
      // Titles and their copies: the custodian, the assistants and the librarian (never deleted
      // from the app: a removed title is { deleted: true }). The catalogue (bookIndex) and the
      // places are what every active teacher reads: titles, how many copies, where, and who
      // borrowed them; never learner names. The School Head reads them too (Items · Books).
      match /books/{bookId} {
        allow read: if canView(schoolId) || isLibrarian(schoolId);
        allow create, update: if bookStaff(schoolId);
        allow delete: if isCustodian(schoolId);   // Reset app only
      }
      match /bookMeta/{docId} {
        allow read: if canView(schoolId) || isMember(schoolId) || isHead(schoolId);
        allow create, update: if bookStaff(schoolId) && docId == 'places';
        allow delete: if isCustodian(schoolId);   // Reset app only
      }
      match /bookIndex/{n} {
        allow read: if canView(schoolId) || isMember(schoolId) || isHead(schoolId);
        allow create, update: if bookStaff(schoolId) && n.matches('^[0-9]{1,3}$');
        allow delete: if isCustodian(schoolId);   // Reset app only
      }
      // Books issued to an adviser (toUid): they read it and sign it once ("Received": status
      // 'sent' → 'done', with their name and the time). The librarian moves library books.
      match /bookMoves/{moveId} {
        allow read: if canView(schoolId) || isLibrarian(schoolId)
          || (signedIn() && resource.data.toUid == request.auth.uid);
        allow create: if isStaff(schoolId)
          || (isLibrarian(schoolId) && request.resource.data.kind in ['move', 'return'] && request.resource.data.get('toUid', '') == '');
        allow update: if isStaff(schoolId)
          || (isMember(schoolId) && resource.data.toUid == request.auth.uid
              && resource.data.status == 'sent' && request.resource.data.status == 'done'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'receivedMs', 'receivedBy', 'updatedAt'])
              && shortText(request.resource.data.get('receivedBy', ''), 80));
        allow delete: if isCustodian(schoolId);   // Reset app only
      }
      // Borrowing. A teacher asks for themselves ('requested'); the keeper of the copies (keeperUid:
      // the teacher whose room it is), the librarian or the custodian lends ('out'), declines, takes
      // it back ('returned') or marks it lost. The borrower may cancel a request, or say they
      // returned it (retSaidMs). Each teacher reads only the loans they borrowed or keep.
      match /loans/{loanId} {
        function loanOk(d) {
          return d.bookId is string && d.bookId.size() > 0 && d.bookId.size() <= 80
            && d.qty is int && d.qty > 0 && d.qty <= 500
            && shortText(d.get('title', ''), 200) && shortText(d.get('borrowerName', ''), 80)
            && shortText(d.get('borrowerNote', ''), 80) && shortText(d.get('note', ''), 200)
            && d.get('acc', []) is list && d.get('acc', []).size() <= 100;
        }
        allow read: if canView(schoolId) || isLibrarian(schoolId)
          || (signedIn() && (resource.data.borrowerUid == request.auth.uid || resource.data.keeperUid == request.auth.uid));
        allow create: if (bookStaff(schoolId) && loanOk(request.resource.data))
          || (isMember(schoolId) && loanOk(request.resource.data)
              && request.resource.data.borrowerUid == request.auth.uid
              && request.resource.data.status == 'requested'
              && request.resource.data.keeperUid != request.auth.uid);
        allow update: if (bookStaff(schoolId) && loanOk(request.resource.data))
          || (isMember(schoolId) && resource.data.keeperUid == request.auth.uid
              && resource.data.borrowerUid != request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'outMs', 'lentBy', 'dueISO', 'decidedNote', 'decidedMs',
                                                                                   'returnedMs', 'retBy', 'lostMs', 'lostBy', 'updatedAt'])
              && (resource.data.status == 'requested' ? request.resource.data.status in ['out', 'declined', 'requested']
                  : resource.data.status == 'out' && request.resource.data.status in ['out', 'returned', 'lost'])
              && shortText(request.resource.data.get('decidedNote', ''), 200))
          || (signedIn() && resource.data.borrowerUid == request.auth.uid
              && ((resource.data.status == 'requested' && request.resource.data.status == 'cancelled'
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
                  || (resource.data.status == 'out' && request.resource.data.status == 'out'
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['retSaidMs', 'updatedAt']))));
        allow delete: if isCustodian(schoolId);   // Reset app only
      }
      // An adviser's class sheet ({schoolYear}_{uid}): the textbooks with their learners, returned,
      // damaged, lost and paid, and (optional) learner NAMES only. Only the adviser and the
      // custodian / assistants read it (Data Privacy Act); not the librarian, not other teachers.
      // Leave (CS Form No. 6), a pilot: only the schools listed in leavePilot(). The teacher applies
      // (their own, status 'applied') and may cancel it while it is still 'applied'; the AO (the
      // custodian's account, or an assistant) receives, recommends, prepares Form 6 and records each
      // step. The School Head approves through approvals (kind 'leave'). A teacher reads only their own.
      // The AO applies for their own leave as staff (by 'self'); the School Head applies for theirs
      // (by 'head', approved by the Division) and may cancel it while it is still 'applied'.
      // The ₱250 log (p250: paid, turned over to the Faculty President) is written by the AO.
      match /leaves/{leaveId} {
        function leaveBodyOk() {
          let d = request.resource.data;
          return d.status in ['applied', 'sh', 'approved', 'hold', 'returned', 'review', 'handed', 'signed', 'done', 'declined', 'cancelled']
            && d.get('uid', '') is string && shortText(d.get('name', ''), 120) && d.get('name', '').size() > 0
            && shortText(d.get('reason', ''), 600) && shortText(d.get('type', ''), 12)
            && d.get('log', []) is list && d.get('log', []).size() <= 80;
        }
        allow read: if leavePilot(schoolId) && (canView(schoolId) || isHead(schoolId)
          || (signedIn() && resource.data.uid == request.auth.uid));
        allow create: if leavePilot(schoolId) && leaveBodyOk() && (isStaff(schoolId)
          || (isMember(schoolId) && request.resource.data.uid == request.auth.uid
              && request.resource.data.status == 'applied' && request.resource.data.by == 'teacher')
          || (isHead(schoolId) && request.resource.data.uid == request.auth.uid
              && request.resource.data.status == 'applied' && request.resource.data.by == 'head'));
        allow update: if leavePilot(schoolId) && leaveBodyOk() && (
          (isStaff(schoolId) && request.resource.data.get('uid', '') == resource.data.get('uid', ''))
          || ((isMember(schoolId) || isHead(schoolId)) && resource.data.uid == request.auth.uid && resource.data.status == 'applied'
              && request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledMs', 'log', 'updatedAt'])));
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // Leave cards (the credits ledger): one per person, written by the AO (custodian or
      // assistant) only. The card of someone in the app has their uid as its id. A teacher reads
      // their own card.
      match /leaveCards/{cardId} {
        allow read: if leavePilot(schoolId) && (canView(schoolId) || isHead(schoolId)
          || (signedIn() && resource.data.uid == request.auth.uid));
        allow create, update: if leavePilot(schoolId) && isStaff(schoolId)
          && request.resource.data.get('uid', '') is string
          && (request.resource.data.get('uid', '') == '' || request.resource.data.uid == cardId)
          && (resource == null || request.resource.data.get('uid', '') == resource.data.get('uid', ''))
          && shortText(request.resource.data.get('name', ''), 120) && request.resource.data.get('name', '').size() > 0
          && request.resource.data.get('entries', []) is list && request.resource.data.get('entries', []).size() <= 800;
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // School calendar (School Planning pilot): one document per school year with its terms,
      // holidays, breaks and days without classes. Everyone at the school reads it; the School Head
      // and the AO (custodian, assistants) write it.
      match /planYears/{sy} {
        allow read: if planPilot(schoolId) && (canView(schoolId) || isHead(schoolId) || isMember(schoolId));
        allow create, update: if planPilot(schoolId) && (isStaff(schoolId) || isHead(schoolId))
          && request.resource.data.get('sy', '') == sy && sy.matches('^[0-9]{4}-[0-9]{4}$')
          && request.resource.data.get('terms', []) is list && request.resource.data.get('terms', []).size() <= 4
          && request.resource.data.get('days', []) is list && request.resource.data.get('days', []).size() <= 400
          && shortText(request.resource.data.get('memo', ''), 300);
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // Programs, projects, activities and school events (School Planning pilot). For now only
      // school events, written by the School Head and the AO; removing one keeps it (removed: true).
      match /ppas/{ppaId} {
        function ppaBodyOk() {
          let d = request.resource.data;
          return d.get('kind', '') == 'event' && shortText(d.get('title', ''), 160) && d.get('title', '').size() > 0
            && d.get('sy', '') is string && d.get('sy', '').matches('^[0-9]{4}-[0-9]{4}$')
            && d.get('from', '') is string && d.get('from', '').size() == 10 && d.get('to', '') is string
            && d.get('status', '') in ['planned', 'cancelled']
            && shortText(d.get('venue', ''), 120) && shortText(d.get('note', ''), 400)
            && d.get('log', []) is list && d.get('log', []).size() <= 80;
        }
        allow read: if planPilot(schoolId) && (canView(schoolId) || isHead(schoolId) || isMember(schoolId));
        allow create, update: if planPilot(schoolId) && (isStaff(schoolId) || isHead(schoolId)) && ppaBodyOk();
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      match /classBooks/{classId} {
        allow read: if canView(schoolId) || (signedIn() && resource.data.uid == request.auth.uid);
        allow create, update: if isStaff(schoolId)
          || (isMember(schoolId) && request.resource.data.uid == request.auth.uid
              && classId == request.resource.data.get('sy', '') + '_' + request.auth.uid
              && (resource == null || resource.data.uid == request.auth.uid)
              && request.resource.data.get('learners', []) is list && request.resource.data.get('learners', []).size() <= 80
              && request.resource.data.get('titles', []) is list && request.resource.data.get('titles', []).size() <= 60);
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      match /turnoverInvites/{code} {
        allow get: if signedIn();
        allow create, update: if isCustodian(schoolId) || isHead(schoolId);
        allow list: if canView(schoolId) || isHead(schoolId);
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // Supplies left, published from the custodian's inventory (no prices, no property numbers).
      match /stock/{code} {
        allow read: if canView(schoolId) || isMember(schoolId);
        allow create, update: if isStaff(schoolId);
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // "I took this": the amounts a teacher took, subtracted from the stock everyone sees until
      // the custodian confirms (RIS → 'done') or corrects it ('cancelled'). Same ID as the request.
      match /stockHolds/{holdId} {
        allow read: if canView(schoolId) || isMember(schoolId);
        allow create: if isMember(schoolId)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'reqId', 'lines', 'status', 'createdMs'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.reqId == holdId
          && request.resource.data.status == 'open'
          && request.resource.data.lines is list
          && request.resource.data.lines.size() > 0 && request.resource.data.lines.size() <= 50;
        allow update: if (isStaff(schoolId) && request.resource.data.uid == resource.data.uid)
          || (signedIn() && resource.data.uid == request.auth.uid
              && resource.data.status == 'open' && request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // Releases (RIS for supplies, ICS for equipment, returns): written by the custodian only.
      // A teacher reads only the ones made out to their own account (query: teacherUid == uid).
      match /releases/{releaseId} {
        allow create, update: if isStaff(schoolId);
        allow get, list: if signedIn()
          && (resource.data.teacherUid == request.auth.uid || canView(schoolId) || isHead(schoolId));
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // A teacher's answers about their items: "received", "problem" or "return". Teachers
      // create their own (always 'open') and read only their own; the custodian resolves them.
      match /teacherReports/{reportId} {
        allow create: if isMember(schoolId)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'kind', 'releaseId', 'releaseNo', 'code', 'desc',
                                                   'units', 'reason', 'note', 'status', 'createdMs', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.kind in ['received', 'problem', 'return', 'count', 'life']   // count: their year-end count; life: "still working" past its useful life
          && request.resource.data.status == 'open'
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && shortText(request.resource.data.desc, 160)
          && shortText(request.resource.data.note, 300)
          && request.resource.data.units is list && request.resource.data.units.size() <= 50;
        allow get, list: if signedIn()
          && (resource.data.uid == request.auth.uid || canView(schoolId));
        allow update: if (isStaff(schoolId) && request.resource.data.uid == resource.data.uid)
          || (isCustodian(schoolId) && request.resource.data.get('mergedFrom', '') == resource.data.uid);
        allow delete: if isCustodian(schoolId);   // Reset app only
      }
    }
  }
}
