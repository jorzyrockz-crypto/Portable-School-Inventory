rules_version = '2';

// CustodianPro · Supply Requests
// Publish in Firebase console → Firestore Database → Rules (see README).
//
//   schools/{schoolId}                        a school; custodians[] may manage it
//   schools/{schoolId}/requests/{id}          supply requests from teachers
//   schools/{schoolId}/purchaseRequests/{id}  Purchase Requests (Appendix 60)
//   schools/{schoolId}/inventory/{code}       My Items (school inventory), custodian only
//   schools/{schoolId}/catalog/{code}         custom catalog items, custodian only
//   schools/{schoolId}/settings/info          school & custodian info, custodian only
//   schools/{schoolId}/members/{uid}          teachers who joined (each writes their own)
//   schools/{schoolId}/releases/{id}          RIS / ICS releases to teachers (teacher reads own)
//   schools/{schoolId}/teacherReports/{id}    received / problem / return / count, from teachers (own only)
//   schools/{schoolId}/stock/{code}           supplies left (name, unit, qty), for teachers who were approved
//   schools/{schoolId}/stockHolds/{requestId} "I took this" from a teacher, until the custodian confirms
//   schools/{schoolId}/invites/{code}         the current invite link (after "New invite link")
//   schoolIds/{schoolNo}                      DepEd School ID (6 digits) → school, so teachers can type it
//
// Members: a teacher who joins waits for the custodian's approval (status 'pending'), then is
// 'active'; the custodian can also edit their name or remove them ('removed'). Cards written
// before approvals existed have no status and count as active. Only active members send
// requests or reports and see the stock.
// Teachers join from the invite link (anonymously, or with Google to keep their requests
// across phones): they can send requests and see or cancel only their own. The property
// custodian signs in with Google or email + password and sees, reviews and approves
// every request of their school.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // A real account (not an anonymous teacher) may set up a school.
    function withAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider in ['password', 'google.com'];
    }
    function isCustodian(schoolId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/schools/$(schoolId)).data.custodians;
    }
    function shortText(v, max) { return v is string && v.size() <= max; }
    function memberPath(schoolId) {
      return /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid);
    }
    function isMember(schoolId) {
      return signedIn() && exists(memberPath(schoolId))
        && get(memberPath(schoolId)).data.get('status', 'active') == 'active'
        && notErasing(schoolId);
    }
    // Reset app marks the school { erasing } before deleting it: no new cards or teacher writes.
    function notErasing(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)).data.get('erasing', 0) == 0;
    }
    // After "New invite link", joining needs the current link's code.
    function inviteOk(schoolId, data) {
      return !get(/databases/$(database)/documents/schools/$(schoolId)).data.get('inviteOnly', false)
        || (data.get('invite', '') is string && data.get('invite', '').size() > 0
            && exists(/databases/$(database)/documents/schools/$(schoolId)/invites/$(data.invite))
            && get(/databases/$(database)/documents/schools/$(schoolId)/invites/$(data.invite)).data.active == true);
    }

    // DepEd School ID → school: a teacher may type "114656" instead of the school code. Only
    // an exact ID can be looked up (no listing). One school per ID: the first custodian who
    // lists it keeps it, and only a custodian of that school can change or remove it. Joining
    // still waits for the custodian's Approve, and an invite-only school still needs its link.
    match /schoolIds/{schoolNo} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && schoolNo.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['schoolId', 'name', 'updatedMs'])
        && request.resource.data.schoolId is string
        && isCustodian(request.resource.data.schoolId)
        && shortText(request.resource.data.name, 120);
      allow update: if request.resource.data.keys().hasOnly(['schoolId', 'name', 'updatedMs'])
        && shortText(request.resource.data.name, 120)
        && ((isCustodian(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId)
            // its school was erased (Reset app): free for the next school that lists it
            || (!exists(/databases/$(database)/documents/schools/$(resource.data.schoolId))
                && request.resource.data.schoolId is string
                && isCustodian(request.resource.data.schoolId)));
      allow delete: if isCustodian(resource.data.schoolId);
    }

    match /schools/{schoolId} {
      // Teachers read the school name after opening the invite link (the ID is the secret).
      allow get: if signedIn();
      // A custodian finds their own school on a new device (query: custodians array-contains uid).
      allow list: if signedIn() && request.auth.uid in resource.data.custodians;
      allow create: if withAccount()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.custodians == [request.auth.uid]
        && shortText(request.resource.data.name, 120);
      allow update: if isCustodian(schoolId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      // More → Reset app → "and the school in the cloud": the custodian erases every document
      // of the school (its sub-collections first, this document last). Nobody else can delete.
      allow delete: if isCustodian(schoolId);

      match /requests/{requestId} {
        // kind 'took': the teacher already took it from the supply room (custodian confirms → RIS)
        allow create: if (isCustodian(schoolId) || isMember(schoolId))
          && request.resource.data.keys().hasOnly(['uid', 'name', 'position', 'office', 'purpose', 'neededBy',
                                                   'lines', 'status', 'createdAt', 'clientAt', 'via', 'kind'])
          && request.resource.data.get('kind', 'request') in ['request', 'took']
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && shortText(request.resource.data.position, 80)
          && shortText(request.resource.data.office, 80)
          && shortText(request.resource.data.purpose, 300)
          && request.resource.data.lines is list
          && request.resource.data.lines.size() > 0 && request.resource.data.lines.size() <= 50;

        // Teachers: only their own requests (the app queries where uid == their uid).
        allow get, list: if signedIn()
          && (resource.data.uid == request.auth.uid || isCustodian(schoolId));

        // Custodian: review, approve, decline, put on a PR. Teacher: cancel while pending.
        allow update: if (isCustodian(schoolId) && request.resource.data.uid == resource.data.uid)
          || (signedIn() && resource.data.uid == request.auth.uid
              && resource.data.status == 'pending'
              && request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      match /purchaseRequests/{prId} {
        allow read, create, update: if isCustodian(schoolId);
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // School inventory (My Items), custom catalog items and school info: the custodian's
      // devices only. Teachers never read the inventory. Removed items are marked
      // { deleted: true } instead of being deleted.
      match /inventory/{code} {
        allow read, create, update: if isCustodian(schoolId);
        allow delete: if isCustodian(schoolId);   // Reset app only
      }
      match /catalog/{code} {
        allow read, create, update: if isCustodian(schoolId);
        allow delete: if isCustodian(schoolId);   // Reset app only
      }
      match /settings/{docId} {
        allow read, create, update: if isCustodian(schoolId);
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // Teachers who joined: each teacher's phone writes its own card (name, position, office),
      // starting as 'pending'. The custodian reads all of them, approves, edits or removes.
      match /members/{uid} {
        function cardOk() {
          return request.resource.data.uid == uid
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
            && shortText(request.resource.data.position, 80)
            && shortText(request.resource.data.office, 80)
            && shortText(request.resource.data.get('email', ''), 120);
        }
        allow get: if signedIn() && (request.auth.uid == uid || isCustodian(schoolId));
        allow list: if isCustodian(schoolId);
        allow create: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/schools/$(schoolId))
          && notErasing(schoolId)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'position', 'office', 'email', 'joinedMs', 'updatedAt', 'status', 'invite'])
          && request.resource.data.status == 'pending'
          && inviteOk(schoolId, request.resource.data)
          && cardOk();
        // The teacher: their own details only (never the status).
        allow update: if (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'position', 'office', 'email', 'joinedMs', 'updatedAt'])
            && cardOk())
          // The custodian: approve, remove, or correct the details.
          || (isCustodian(schoolId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'position', 'office', 'status',
                                                                                 'approvedMs', 'removedMs', 'editedMs', 'by', 'updatedAt'])
            && request.resource.data.get('status', 'active') in ['pending', 'active', 'removed']
            && cardOk());
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // The current invite link's code (the school document only says inviteOnly: true).
      match /invites/{code} {
        allow get: if signedIn();
        allow create, update: if isCustodian(schoolId);
        allow list, delete: if isCustodian(schoolId);   // Reset app finds and erases them
      }

      // Supplies left, published from the custodian's inventory (no prices, no property numbers).
      match /stock/{code} {
        allow read: if isCustodian(schoolId) || isMember(schoolId);
        allow create, update: if isCustodian(schoolId);
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // "I took this": the amounts a teacher took, subtracted from the stock everyone sees until
      // the custodian confirms (RIS → 'done') or corrects it ('cancelled'). Same ID as the request.
      match /stockHolds/{holdId} {
        allow read: if isCustodian(schoolId) || isMember(schoolId);
        allow create: if isMember(schoolId)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'reqId', 'lines', 'status', 'createdMs'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.reqId == holdId
          && request.resource.data.status == 'open'
          && request.resource.data.lines is list
          && request.resource.data.lines.size() > 0 && request.resource.data.lines.size() <= 50;
        allow update: if (isCustodian(schoolId) && request.resource.data.uid == resource.data.uid)
          || (signedIn() && resource.data.uid == request.auth.uid
              && resource.data.status == 'open' && request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // Releases (RIS for supplies, ICS for equipment, returns): written by the custodian only.
      // A teacher reads only the ones made out to their own account (query: teacherUid == uid).
      match /releases/{releaseId} {
        allow create, update: if isCustodian(schoolId);
        allow get, list: if signedIn()
          && (resource.data.teacherUid == request.auth.uid || isCustodian(schoolId));
        allow delete: if isCustodian(schoolId);   // Reset app only
      }

      // A teacher's answers about their items: "received", "problem" or "return". Teachers
      // create their own (always 'open') and read only their own; the custodian resolves them.
      match /teacherReports/{reportId} {
        allow create: if isMember(schoolId)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'kind', 'releaseId', 'releaseNo', 'code', 'desc',
                                                   'units', 'reason', 'note', 'status', 'createdMs', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.kind in ['received', 'problem', 'return', 'count']   // count: their year-end count
          && request.resource.data.status == 'open'
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && shortText(request.resource.data.desc, 160)
          && shortText(request.resource.data.note, 300)
          && request.resource.data.units is list && request.resource.data.units.size() <= 50;
        allow get, list: if signedIn()
          && (resource.data.uid == request.auth.uid || isCustodian(schoolId));
        allow update: if isCustodian(schoolId) && request.resource.data.uid == resource.data.uid;
        allow delete: if isCustodian(schoolId);   // Reset app only
      }
    }
  }
}
